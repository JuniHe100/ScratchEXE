@echo off
setlocal
title ScratchEXE Installer
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $Repo='JuniHe100/ScratchEXE'; $Install=Join-Path $env:LOCALAPPDATA 'ScratchEXE'; $Temp=Join-Path $env:TEMP 'ScratchEXEInstaller'; try { Write-Host 'Checking latest GitHub release...'; $Release=Invoke-RestMethod -Uri ('https://api.github.com/repos/'+$Repo+'/releases/latest') -Headers @{'User-Agent'='ScratchEXE'}; $Asset=$Release.assets | Where-Object {$_.name -like '*.zip'} | Select-Object -First 1; if(!$Asset){throw 'No ZIP found in latest release.'}; Write-Host ('Downloading '+$Release.tag_name+'...'); Remove-Item $Temp -Recurse -Force -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force $Temp,$Install | Out-Null; $Zip=Join-Path $Temp $Asset.name; Invoke-WebRequest $Asset.browser_download_url -OutFile $Zip -UseBasicParsing; Write-Host 'Extracting...'; Expand-Archive $Zip $Install -Force; $Packager=Join-Path $Install 'Runtime\Source\packager'; if(!(Test-Path $Packager)){throw 'Runtime\Source\packager was not found in the release.'}; if(!(Test-Path (Join-Path $Packager 'node_modules'))){ Write-Host 'Installing missing dependencies...'; if(!(Get-Command node -ErrorAction SilentlyContinue)){throw 'Node.js is required. Install Node.js and run the installer again.'}; Push-Location $Packager; npm ci; if($LASTEXITCODE -ne 0){npm install}; if($LASTEXITCODE -ne 0){throw 'Could not install dependencies.'}; Pop-Location }; $Exe=Get-ChildItem $Install -Filter 'ScratchEXE.exe' -Recurse -File | Select-Object -First 1; if(!$Exe){throw 'ScratchEXE.exe was not found.'}; Write-Host ''; Write-Host 'SCRATCHEXE INSTALLED SUCCESSFULLY!' -ForegroundColor Green; Write-Host ('Version: '+$Release.tag_name); Start-Process $Exe.FullName -WorkingDirectory $Exe.DirectoryName } catch { Write-Host ''; Write-Host ('INSTALLER ERROR: '+$_.Exception.Message) -ForegroundColor Red; pause; exit 1 }"
